# PostgreSQL de Supabase. Copia esta plantilla a backend/.env y configura el
# connection string desde Project Settings > Database > Connection string.
# Elige conexión directa si el VPS tiene IPv6; si no, usa el pooler de sesión.
# Nunca uses una URL del navegador ni una clave Supabase service_role aquí.
PORT=3001
DATABASE_URL=
# Ruta local/privada al certificado raíz descargado de Supabase. Guárdalo
# fuera de Git; si se omite, Node usa las CA confiables del sistema.
DATABASE_SSL_CA_PATH=
DATABASE_POOL_MAX=5
DATABASE_CONNECTION_TIMEOUT_MS=10000
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWT_AUDIENCE=authenticated

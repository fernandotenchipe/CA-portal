{
  "name": "ca-portal-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "db:check": "node --env-file-if-exists=.env dist/scripts/check-db.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.86.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.5",
    "typescript": "^5.0.0"
  }
}
